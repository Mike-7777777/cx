#!/bin/sh
# cx pre-commit hook: fast format check (~1s)
# Install: make install-hooks

set -e

# Run gofmt and check for actual content changes (ignores CRLF diffs).
gofmt -w . 2>/dev/null
if ! git diff --quiet -- '*.go' 2>/dev/null; then
    echo "pre-commit: gofmt produced changes:"
    git diff --name-only -- '*.go'
    git checkout -- '*.go' 2>/dev/null
    echo ""
    echo "Run: gofmt -w . && git add -u"
    exit 1
fi
