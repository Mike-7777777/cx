#!/bin/sh
# cx pre-push hook: full quality gate before pushing
# Install: make install-hooks
#
# Runs: gofmt check, go mod tidy check, go vet, tests, build
# Takes ~15s. Prevents pushing broken code to remote.

set -e

echo "[pre-push] Running quality checks..."

# 1. Format (run gofmt -w then check for uncommitted diffs — handles CRLF correctly)
gofmt -w . 2>/dev/null
if ! git diff --quiet -- '*.go' 2>/dev/null; then
    echo "FAIL: gofmt produced changes:"
    git diff --name-only -- '*.go'
    git checkout -- '*.go' 2>/dev/null
    echo "Run: gofmt -w . && git add -u"
    exit 1
fi
echo "  gofmt .......... ok"

# 2. Module tidy
go mod tidy
if ! git diff --quiet go.mod go.sum 2>/dev/null; then
    git checkout go.mod go.sum 2>/dev/null
    echo "FAIL: go.mod/go.sum not tidy — run 'go mod tidy'"
    exit 1
fi
echo "  go mod tidy ..... ok"

# 3. Vet
go vet ./... 2>&1
echo "  go vet .......... ok"

# 4. Tests (skip -race on Windows — file locking issues with CGo)
RACE_FLAG="-race"
if [ "$(uname -s | cut -c1-5)" = "MINGW" ] || [ "$(uname -s | cut -c1-4)" = "MSYS" ] || [ -n "$WINDIR" ]; then
    RACE_FLAG=""
fi
go test ./... -count=1 $RACE_FLAG > /dev/null 2>&1
echo "  go test ......... ok"

# 5. Build (use temp name on Windows to avoid locked-binary conflict)
OUT="/dev/null"
if [ -n "$WINDIR" ]; then
    OUT="cx-hooktest.exe"
fi
go build -o "$OUT" . 2>&1
[ "$OUT" != "/dev/null" ] && rm -f "$OUT"
echo "  go build ........ ok"

echo "[pre-push] All checks passed."
